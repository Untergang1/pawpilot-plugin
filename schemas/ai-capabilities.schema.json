{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-capabilities manifest (documentation view)",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "1.3" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "minLength": 1 },
    "systemPrompt": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "description": { "type": "string", "minLength": 1 },
          "ownerOnly": { "type": "boolean", "default": false },
          "inputSchema": { "type": "object", "properties": { "type": { "const": "object" } }, "required": ["type"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
